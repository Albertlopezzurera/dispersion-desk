# ---------------------------------------------------------------------------
# Dispersion Desk - environment template
# Copy to .env and fill in.  .env is git-ignored and MUST NEVER be committed.
# ---------------------------------------------------------------------------

# --- Alpaca (paper trading account created fresh for this hackathon) --------
# Get these from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Account ID of the dedicated hackathon paper account (goes in the submission).
ALPACA_ACCOUNT_ID=

# Options data feed: "indicative" (free) or "opra" (paid subscription).
ALPACA_OPTIONS_FEED=indicative

# --- LLM provider ----------------------------------------------------------
# featherless | openai_compatible | mock
# "mock" is a deterministic offline provider used by the test-suite.
LLM_PROVIDER=featherless
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_API_KEY=

# --- Safety switches -------------------------------------------------------
# true  -> the agent analyses and proposes but NEVER submits an order.
PROPOSE_ONLY=true
# Global kill switch. true -> orchestrator refuses to run any cycle.
KILL_SWITCH=false

# --- Risk limits (deterministic engine; all values are hard caps) ----------
MAX_NET_DELTA=150            # portfolio net delta must stay inside +/- this
MAX_PORTFOLIO_VEGA=400       # absolute vega exposure, $ per 1 vol point
MAX_PORTFOLIO_GAMMA=50
MAX_DAILY_THETA=250          # max $ time-decay burn per day
MAX_RISK_PER_BASKET_PCT=1.5  # max defined risk per basket, % of NAV
MAX_TOTAL_RISK_PCT=10.0      # max aggregate defined risk, % of NAV
MAX_UNDERLYING_CONCENTRATION_PCT=4.0
MAX_DAILY_LOSS_PCT=3.0       # circuit breaker: halts trading for the day

# --- Liquidity / data-quality gates ---------------------------------------
MAX_SPREAD_PCT_OF_MID=12.0   # reject contracts wider than this
MIN_OPEN_INTEREST=25
MAX_QUOTE_AGE_SECONDS=900    # indicative feed is delayed; reject stale quotes
MIN_IV=0.01
MAX_IV=5.00

# --- Strategy parameters ---------------------------------------------------
INDEX_SYMBOL=SPY
DISPERSION_Z_ENTRY=1.5       # |z| threshold to open a basket
DISPERSION_Z_EXIT=0.4
TARGET_DTE_MIN=21
TARGET_DTE_MAX=45
CYCLE_INTERVAL_SECONDS=900

# --- Persistence -----------------------------------------------------------
DATABASE_URL=sqlite:///./data/dispersion_desk.db
LOG_LEVEL=INFO
